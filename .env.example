# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase Dashboard: Project Settings > API.
#
# The EXPO_PUBLIC_ prefix is required so these are available in the app at runtime.
# Restart `npm start` after changing .env.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The single email allowed to sign in and use the app. This is a PRIVATE app —
# only this account can read or write expenses. Must match the owner email used
# in the RLS policies in supabase/schema.sql.
EXPO_PUBLIC_OWNER_EMAIL=

# Multi-user: the allowed accounts as "email:Name,email2:Name2". Each person has
# their own passcode and their own private expenses. If set, this takes
# precedence over EXPO_PUBLIC_OWNER_EMAIL. Keep in sync with the OWNER_USERS
# function secret and supabase/schema-multiuser.sql.
EXPO_PUBLIC_APP_USERS=
